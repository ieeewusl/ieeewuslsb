# ========================================================
# IEEE WUSL Student Branch - Environment Variables
# ========================================================

# Supabase Project Configuration (From your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Public site URL (defaults to Vercel deployment URL if omitted)
NEXT_PUBLIC_SITE_URL=https://ieeewusl.org

